# ============================================================================
# deploy.env — the ONE place to set every value the Dokimion EKS manifests need.
#
# Edit the values below, then:
#     ./apply.sh render     # preview the rendered YAML (no cluster changes)
#     ./apply.sh diff       # kubectl diff against the cluster
#     ./apply.sh apply      # render + kubectl apply (in order)
#
# apply.sh sources this file as shell, so later vars may reference earlier ones
# (e.g. QUACK_UI_URL uses DOKIMION_HOST). Only the ${VARS} named here are substituted
# into the manifests — nothing else in the YAML is touched.
#
# !! SECRET !! AUTH_ADMIN_PASSWORD_CIPHER is sensitive. Do NOT commit a filled-in copy of this
# file. Either keep your edits out of git (`git update-index --skip-worktree deploy.env`) or move
# the admin secret to AWS Secrets Manager + External Secrets (see README) and leave it blank here.
# ============================================================================

# --- Container image (ECR) --------------------------------------------------
#   <account-id>.dkr.ecr.<region>.amazonaws.com/<repo>:<tag>
#   Create the repo (gives you the URI):
#       aws ecr create-repository --repository-name dokimion --region <region>
#   You can fill this in and even `apply` before pushing — the pod just won't start until the
#   image is pushed (ImagePullBackOff until then).
ECR_IMAGE="123456789012.dkr.ecr.us-east-1.amazonaws.com/dokimion:latest"

# --- Public hostname --------------------------------------------------------
#   The DNS name users browse to. Drives: the Ingress host, the session-cookie domain
#   (auth.domain), and the UI URL. After `apply`, point this name at the ALB (Route 53 ALIAS).
DOKIMION_HOST="dokimion.example.org"
QUACK_UI_URL="https://${DOKIMION_HOST}"        # derived — change only if the public scheme differs

# --- Admin password (AES ciphertext, NOT plaintext) -------------------------
#   Generate from your chosen admin password with the repo helper (run from deploy/eks):
#       java aes-encrypt.java 'YourAdminPassword'
#   ...then paste the printed Base64 string here.
AUTH_ADMIN_PASSWORD_CIPHER="REPLACE_WITH_AES_CIPHERTEXT"

# --- TLS certificate (ACM) --------------------------------------------------
#   ARN of an ACM cert covering DOKIMION_HOST, in the ALB's region:
#       aws acm list-certificates --region <region>
ACM_CERT_ARN="arn:aws:acm:us-east-1:123456789012:certificate/REPLACE"

# --- Cognito (the ALB login gate) -------------------------------------------
#   A Cognito User Pool + hosted domain + app client. The app client's allowed callback URL MUST
#   include  https://<DOKIMION_HOST>/oauth2/idpresponse  and sign-out URL  https://<DOKIMION_HOST>.
#       aws cognito-idp list-user-pools --max-results 10
#       aws cognito-idp describe-user-pool-client --user-pool-id <id> --client-id <id>
COGNITO_USER_POOL_ARN="arn:aws:cognito-idp:us-east-1:123456789012:userpool/us-east-1_REPLACE"
COGNITO_APP_CLIENT_ID="REPLACE_APP_CLIENT_ID"
COGNITO_DOMAIN_PREFIX="REPLACE_DOMAIN_PREFIX"   # the domain PREFIX only, e.g. dokimion-auth (not the full URL)
